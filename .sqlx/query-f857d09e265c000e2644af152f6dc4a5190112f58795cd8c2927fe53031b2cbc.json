  "db_name": "PostgreSQL",
  "query": "\n        SELECT aa.user_id, u.username, u.public_key, aa.role, aa.status, aa.last_edit_at, aa.created_at\n        FROM apps_access aa\n        JOIN users u ON u.id = aa.user_id\n        WHERE aa.app_id = $1\n        ORDER BY aa.created_at\n        ",
