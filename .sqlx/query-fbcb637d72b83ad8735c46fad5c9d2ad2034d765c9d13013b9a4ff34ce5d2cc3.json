  "query": "\n        UPDATE apps_data\n        SET encrypted_json = $4,\n            type = COALESCE($5, type),\n            format = COALESCE($6, format),\n            date = COALESCE($7, date),\n            version = version + 1,\n            edited_at = now()\n        WHERE app_id = $1 AND id = $2 AND version = $3\n        RETURNING id, app_id, type, format, encrypted_json, date, edited_at, version\n        ",
