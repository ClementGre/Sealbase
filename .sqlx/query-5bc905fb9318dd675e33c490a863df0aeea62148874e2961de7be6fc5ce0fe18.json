  "query": "\n        SELECT id, deleted_at FROM apps_data_tombstones\n        WHERE app_id = $1\n          AND ($2::timestamptz IS NULL OR deleted_at >= $2)\n          AND ($3::timestamptz IS NULL OR (deleted_at, id) > ($3, $4))\n        ORDER BY deleted_at, id\n        LIMIT $5\n        ",
