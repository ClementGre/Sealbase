{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT d.id, d.version, r.expected_version AS \"expected_version?\"\n        FROM apps_data d\n        LEFT JOIN app_rotation_rows r ON r.rotation_id = $1 AND r.data_id = d.id\n        WHERE d.app_id = $2 AND (r.data_id IS NULL OR r.expected_version <> d.version)\n        ORDER BY d.id\n        ",
